<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- DNS preferences and downloaded blocklists stay on the device. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
